{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate config for Davvos11 repos deployed to zonnestralen, where merging to master deploys",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": false,
  "ignoreTests": true,
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "* 6-11 * * 6"
  ],
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "* 6-11 * * 6"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Version releases wait 3 days (security fixes don't); digest updates have no release date",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "One automerged PR per repo per week for patch, digest and pin updates",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "safe updates",
      "groupSlug": "safe",
      "automerge": true
    },
    {
      "description": "One PR per repo per week for all minor updates (not merged automatically)",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor updates"
    },
    {
      "description": "Majors only on request, from the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The app's own image: its tag is set by the deploy workflow",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/davvos11/**"
      ],
      "enabled": false
    },
    {
      "description": "nginx: stable releases only (even minor versions; odd ones are mainline)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "nginx"
      ],
      "allowedVersions": "/^1\\.\\d*[02468]\\./"
    }
  ]
}
